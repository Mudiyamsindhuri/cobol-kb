  "summaries": [
    {
      "file": "ABNDPROC.cbl",
      "summary": "This program processes application abends and writes them to a centralized CF (KSDS) datastore."
    },
    {
      "file": "BANKDATA.cbl",
      "summary": "Batch program to initialise the data used in the bank application. Datastores populated by this program include CUSTOMER (VSAM) and ACCOUNT (DB2)."
    },
    {
      "file": "BNK1CAC.cbl",
      "summary": "This program verifies input and calls CREACC to add an account to the Account datastore."
    },
    {
      "file": "BNK1CCA.cbl",
      "summary": "This program lists accounts belonging to a specified customer number."
    },
    {
      "file": "BNK1CCS.cbl",
      "summary": "This program is the Create Customer program in the BANKING application within the BMS suite."
    },
    {
      "file": "BNK1CRA.cbl",
      "summary": "This is the Credit/Debit program in the BANKING application in the BMS suite."
    },
    {
      "file": "BNK1DAC.cbl",
      "summary": "This program is the Display Account program in the BANKING application within the BMS suite. It handles display requests and account deletion."
    },
    {
      "file": "BNK1DCS.cbl",
      "summary": "This program displays customer details, deletes the record if pf5 is pressed, or updates the record if pf10 is pressed."
    },
    {
      "file": "BNK1TFN.cbl",
      "summary": "This is the Transfer Funds between accounts program (in the same bank) in the BANKING application BMS suite."
    },
    {
      "file": "BNK1UAC.cbl",
      "summary": "This file is the Update Account program in the BANKING application."
    },
    {
      "file": "BNKMENU.cbl",
      "summary": "This program displays the map and allows the user to select an option, validates the option number/letter and returns with the appropriate transaction."
    },
    {
      "file": "CRDTAGY1.cbl",
      "summary": "This program is a dummy credit agency used for credit scoring. It delays for a random amount of time and creates a random credit score."
    },
    {
      "file": "CRDTAGY2.cbl",
      "summary": "This program is the dummy credit agency, used for credit scoring. Data is passed to the program via a channel and container and the role of this program is to delay for a random amount of time (between 0 and 3 seconds) and to create a random credit score (between 1 and 999), then finish."
    },
    {
      "file": "CRDTAGY3.cbl",
      "summary": "This program is the dummy credit agency, used for credit scoring. Data is passed to the program via a channel and container and the role of this program is to delay for a random amount of time (between 0 and 3 seconds) and to create a random credit score (between 1 and 999), then finish."
    },
    {
      "file": "CRDTAGY4.cbl",
      "summary": "This program is a dummy credit agency used for credit scoring. It delays for a random amount of time and creates a random credit score."
    },
    {
      "file": "CRDTAGY5.cbl",
      "summary": "This program is the dummy credit agency, used for credit scoring. Data is passed to the program via a channel and container and the role of this program is to delay for a random amount of time (between 0 and 3 seconds) and to create a random credit score (between 1 and 999), then finish."
    },
    {
      "file": "CREACC.cbl",
      "summary": "This program takes account information from the BMS application and updates the account datastore on DB2."
    },
    {
      "file": "CRECUST.cbl",
      "summary": "This program takes customer information, performs credit checks, and updates customer data."
    },
    {
      "file": "DBCRFUN.cbl",
      "summary": "This program processes cash transactions, retrieves account information from DB2, and updates the account balance. It also writes transaction records to the PROCTRAN datastore."
    },
    {
      "file": "DELACC.cbl",
      "summary": "This program takes an incoming account number it then accesses the account datastore and retrieves the associated account record matching on the customer number & the account_type and then deletes it."
    },
    {
      "file": "DELCUS.cbl",
      "summary": "This program takes an incoming customer number & retrieves the associated accounts for it and stores these in an array. Then it deletes the accounts one at a time and writes a PROCTRAN delete account record out for each deleted account. When all accounts have been deleted, it deletes the customer record (and writes out a customer delete record to PROCTRAN)."
    },
    {
      "file": "GETCOMPY.cbl",
      "summary": "This file contains a COBOL program that initializes the COMPANY-NAME variable with 'CICS Bank Sample Application'."
    },
    {
      "file": "GETSCODE.cbl",
      "summary": "This COBOL program retrieves a sort code based on a literal."
    },
    {
      "file": "INQACC.cbl",
      "summary": "This program takes an incoming account number. It then accesses the DB2 datastore & retrieves the associated account record/row matching on the account number & the account_type."
    },
    {
      "file": "INQACCCU.cbl",
      "summary": "This program takes an incoming customer number and determines which accounts it is associated with by accessing the datastore & retrieving the associated account records matching on the customer number"
    },
    {
      "file": "INQCUST.cbl",
      "summary": "This program takes customer number as input and returns to the calling program a commarea containing all of the customer information for that record."
    },
    {
      "file": "UPDACC.cbl",
      "summary": "This program updates account details in a DB2 datastore based on input account record fields."
    },
    {
      "file": "UPDCUST.cbl",
      "summary": "This program gets called when someone updates the customer details. It accesses the VSAM datastore."
    },
    {
      "file": "XFRFUN.cbl",
      "summary": "This program processes fund transfers based on account numbers and amounts."
    }
  ]
}