    {
      "file": "ABNDPROC.cbl",
      "summary": "This program processes application abends and writes them to a centralized CF (KSDS) datastore for centralized viewing."
    },
    {
      "file": "BANKDATA.cbl",
      "summary": "Batch program to initialise the data used in the bank application. Datastores populated by this program include CUSTOMER (VSAM) and ACCOUNT (DB2)."
    },
    {
      "file": "BNK1CAC.cbl",
      "summary": "This COBOL program is the entry point for creating an account, potentially calling the CREACC program to add the account to the Account datastore."
    },
    {
      "file": "BNK1CCA.cbl",
      "summary": "This program lists accounts belonging to a specified customer number."
    },
    {
      "file": "BNK1CCS.cbl",
      "summary": "This COBOL program is part of the BANKING application within the BMS suite and likely handles customer creation."
    },
    {
      "file": "BNK1CRA.cbl",
      "summary": "This is the Credit/Debit program in the BANKING application within the BMS suite."
    },
    {
      "file": "BNK1DAC.cbl",
      "summary": "This program is the Display Account program in the BANKING application within the BMS suite. It also handles account deletion requests."
    },
    {
      "file": "BNK1DCS.cbl",
      "summary": "This COBOL program, BNK1DCS, is a Display Customer program within the BANKING application suite. It allows for customer details display, deletion, or update based on user input (PF5 or PF10)."
    },
    {
      "file": "BNK1TFN.cbl",
      "summary": "This COBOL program is a Transfer Funds between accounts program within the BANKING application BMS suite."
    },
    {
      "file": "BNK1UAC.cbl",
      "summary": "This COBOL program, part of the BANKING application in the BMS suite, is used for updating accounts."
    },
    {
      "file": "BNKMENU.cbl",
      "summary": "This COBOL program is the initial program within the BMS suite, displaying a map and allowing user selection of an option, validating the choice, and returning the appropriate transaction."
    },
    {
